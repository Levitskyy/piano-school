# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Общее
ENVIRONMENT=local
# Сгенерируйте: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# API
# Локальный PostgreSQL в Docker слушает 55432, чтобы не конфликтовать с системным.
DATABASE_URL=postgresql+asyncpg://piano:piano@localhost:55432/piano_school
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://192.168.1.151:8080

# Запуск без курсов: false скрывает каталог, страницы и API курсов (404)
COURSES_ENABLED=true

# Публичный адрес сайта; compose подставляет его в FRONTEND_URL/CORS_ORIGINS/YOOKASSA_RETURN_URL
PUBLIC_BASE_URL=http://localhost:3000

# Auth
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_NAME=ps_session
SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
# За сколько часов до занятия ученик может отменить или перенести его
LESSON_CANCELLATION_HOURS=24

# Web
# Next.js проксирует /api/* в FastAPI; браузер не обращается к API напрямую.
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=/api

# ЮKassa (тестовый магазин)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000
# Слот ждёт оплату это число минут, затем освобождается
PAYMENT_RESERVATION_MINUTES=15

# Email. Локально console возвращает ссылки в ответе API; на проде используется Resend.
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_FROM_NAME=Levickaya Piano
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
# Резервный провайдер, если понадобится
UNISENDER_API_KEY=
UNISENDER_API_URL=https://goapi.unisender.ru/ru/transactional/api/v1
